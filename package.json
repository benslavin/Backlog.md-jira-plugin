{
	"name": "@benslavin/backlog-jira",
	"version": "0.3.3",
	"description": "Bidirectional sync plugin between Backlog.md and Jira via MCP",
	"type": "module",
	"author": "Emanuel Ciuca <emanuel.ciuca@gmail.com>",
	"contributors": ["Ben Slavin <ben@benslavin.com>"],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/benslavin/Backlog.md-jira-plugin.git"
	},
	"bugs": {
		"url": "https://github.com/benslavin/Backlog.md-jira-plugin/issues"
	},
	"homepage": "https://github.com/benslavin/Backlog.md-jira-plugin#readme",
	"keywords": [
		"backlog",
		"jira",
		"plugin",
		"cli",
		"sync",
		"bidirectional",
		"mcp",
		"task-management",
		"atlassian",
		"project-management"
	],
	"bin": {
		"backlog-jira": "dist/cli.js"
	},
	"files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bun build --target=node --external pino --external pino-pretty src/cli.ts --outdir=dist",
		"dev": "bun run src/cli.ts",
		"test": "bun test",
		"test:integration": "./tests/integration/test-clean-install.sh",
		"check": "biome check .",
		"check:types": "tsc --noEmit",
		"check:dist": "bun run build && git diff --exit-code --stat -- dist",
		"prepublishOnly": "npm run build && npm run check && npm run test"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.1",
		"chalk": "^5.6.2",
		"commander": "^12.1.0",
		"pino": "^8.21.0",
		"pino-pretty": "^10.3.1",
		"prompts": "^2.4.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/node": "^20.19.43",
		"@types/prompts": "^2.4.9",
		"bun-types": "^1.4.2",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=20"
	}
}
